# Documentation: docs/environment-variables.md
# Copy to .env for local development. The installation scripts replace the
# development secrets before starting the production containers.

# Docker Compose.
OPENMONETIS_PROJECT_NAME=openmonetis
OPENMONETIS_VERSION=latest
APP_PORT=7002

# PostgreSQL. Local processes connect through DB_HOST_PORT; containers connect
# directly to port 5432 using the same credentials.
POSTGRES_DB=openmonetis
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DB_HOST_PORT=7000

# Optional: use the same external PostgreSQL from local processes and containers.
# Development against the Oracle server (run `pnpm db:tunnel` first):
# EXTERNAL_DATABASE_URL=postgres://openmonetis:<password>@localhost:7010/openmonetis_dev
EXTERNAL_DATABASE_URL=

# Public application URL. The install scripts keep all runtime origins aligned.
OPENMONETIS_URL=http://localhost:7002
BETTER_AUTH_URL=http://localhost:7002
WEB_URL=http://localhost:7002
CORS_ORIGIN=http://localhost:7002
BETTER_AUTH_TRUSTED_ORIGINS=

# Development-only secrets. Generate independent secrets for production.
BETTER_AUTH_SECRET=openmonetis-local-development-secret-change-me
DEVICE_TOKEN_SECRET=development-device-token-secret-change-me
PERSON_CONNECTION_SECRET=development-person-connection-secret-change-me

# Authentication session lifetime and refresh interval.
DISABLE_SIGNUP=false
AUTH_SESSION_EXPIRES_IN_DAYS=30
AUTH_SESSION_UPDATE_AGE_HOURS=24

# Signup: only allowlisted emails can create accounts; the initial admin is seeded on startup.
SIGNUP_POLICY=allowlist
REQUIRE_EMAIL_VERIFICATION=true
INITIAL_ADMIN_EMAIL=

# Transactional email through Resend. Without it, development prints emails to the API console.
RESEND_API_KEY=
EMAIL_FROM=

# Web only: header overwritten by the reverse proxy with the visitor IP (production: x-real-ip).
TRUSTED_CLIENT_IP_HEADER=

# Optional: configure all three credentials to enable attachments. Omit
# S3_ENDPOINT for AWS S3; set it for a compatible service.
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
S3_REGION=us-east-1

# Optional: Google OAuth, disabled while both values stay empty
# (https://console.cloud.google.com/apis/credentials).
# Authorized redirect URI: http://localhost:7002/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional live storage tests only; see docs/testing.md.
# TEST_REAL_WEB_ORIGIN=http://localhost:7002
# TEST_REAL_S3_* overrides corresponding S3_* credentials for the live storage test.

# Optional: merchant logos from Logo.dev (https://www.logo.dev)
# The publishable key is restricted to the image CDN; the secret key stays in the API.
LOGO_DEV_PUBLISHABLE_KEY=
LOGO_DEV_SECRET_KEY=
