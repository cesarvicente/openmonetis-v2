# /opt/openmonetis/app/.env no servidor Oracle (chmod 600). Nunca versionar o arquivo real.
PUBLIC_URL=https://finance.cvicent.com.br

# Container openmonetis-pg na rede "openmonetis"; senha em /opt/openmonetis/db/.env.
DATABASE_URL=postgres://openmonetis:<senha>@openmonetis-pg:5432/openmonetis

# Gerar cada um com: openssl rand -base64 48
BETTER_AUTH_SECRET=
DEVICE_TOKEN_SECRET=
PERSON_CONNECTION_SECRET=

DISABLE_SIGNUP=false
SIGNUP_POLICY=allowlist
REQUIRE_EMAIL_VERIFICATION=true
INITIAL_ADMIN_EMAIL=

RESEND_API_KEY=
EMAIL_FROM=OpenMonetis <noreply@cvicent.com.br>

# Garage (openmonetis-garage); credenciais em /opt/openmonetis/storage/app-key.env.
S3_BUCKET=openmonetis-attachments
S3_ENDPOINT=https://finance-files.cvicent.com.br
S3_REGION=garage
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
